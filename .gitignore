# Hifzapp monorepo (LOCKED 2026-07-12) — frontend HTML/JS + backend Python
# live in the same repo. Previously split across Hifzapp + HafizAssistant
# repos; HafizAssistant is now archived and superseded.

# Excluded folders — local dev artifacts only
mobile/                 # Mobile dev artifacts
web/                    # Old web directory
screenshots/            # Test screenshots

# Backend heavy runtime artifacts (the backend/ .gitignore handles
# Python/venv specifics, this catches anything that slips out)
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/debug_chunks/
backend/*.wav
backend/*.ogg
backend/*.mp3

# Python (defensive — backend is excluded above)
__pycache__/
*.pyc
.venv/
.env

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
