# Backend environment variables
#
# Copy to .env and edit for your setup.

# Path on the HOST where the model files live.
# The container will mount this as /data (read-only).
#
# Required files in this directory (for the streaming FastConformer):
#   - model_streaming_with_encoder.q8.onnx
#   - streaming_global_cmvn.npz
#   - tokenizer.model
#
# Windows:  MODEL_HOST_PATH=C:/Users/Gufran/Documents/model
# Linux:    MODEL_HOST_PATH=/home/user/Documents/model
# macOS:    MODEL_HOST_PATH=/Users/user/Documents/model
MODEL_HOST_PATH=C:/Users/Gufran/Documents/model

# CPU threads for onnxruntime inference. 2-4 is good for Intel UHD.
# More threads = faster inference, but uses more CPU.
NUM_THREADS=2

# Which CMVN variant to use. The streaming_global_cmvn.npz file has
# stats for two training datasets:
#   - 'clean' : tarteel-ai/everyayah (studio recordings)  [default]
#   - 'tlog'  : tarteel-ai/tlog (real-world recitations)
# Switch to 'tlog' if your mic captures more ambient noise than
# studio recordings and the recognition is poor.
CMVN_VARIANT=clean
