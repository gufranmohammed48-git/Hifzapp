# Backend environment variables
#
# Copy to .env and edit for your setup.

# Path on the HOST directory containing fastconformer-quran.nemo.
# The container will mount this as /data (read-only).
#
# Windows:  MODEL_HOST_PATH=C:/Users/Gufran/Downloads/model/nemo
# Linux:    MODEL_HOST_PATH=/home/user/Downloads/model/nemo
# macOS:    MODEL_HOST_PATH=/Users/user/Downloads/model/nemo
MODEL_HOST_PATH=C:/Users/Gufran/Downloads/model/nemo

# Number of CPU cores to allocate to the container. 2 is comfortable
# for Intel UHD; bump to 4 if you have headroom.
CPUS=2

# Memory limit for the container. 3GB is enough for the NeMo model.
MEMORY=3G
