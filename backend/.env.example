# .env file for docker-compose. Copy to .env and edit.
# This file is read by `docker compose` automatically.

# Path to the host directory containing fastconformer-quran.nemo.
# This is mounted into the container at /data.
#
# On Windows (WSL path - works in Docker Desktop for Windows):
#   MODEL_HOST_PATH=/c/Users/Gufran/Downloads/model/nemo
#
# On Windows (Windows path - also works):
#   MODEL_HOST_PATH=C:/Users/Gufran/Downloads/model/nemo
#   MODEL_HOST_PATH=C:\\Users\\Gufran\\Downloads\\model\\nemo
#
# On macOS:
#   MODEL_HOST_PATH=/Users/<yourname>/Downloads/model/nemo
#
# On Linux:
#   MODEL_HOST_PATH=/home/<yourname>/Downloads/model/nemo
#
# Or just set it inline: MODEL_HOST_PATH=/path/to/dir docker compose up
MODEL_HOST_PATH=/c/Users/Gufran/Downloads/model/nemo
