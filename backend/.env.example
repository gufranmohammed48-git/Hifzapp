# Backend environment variables
#
# Copy to .env and edit for your setup.

# Path on the HOST directory containing the int8 ONNX model + tokenizer.
# The container will mount this as /data (read-only).
#
# Required files in this directory:
#   - model_with_encoder.q8.onnx  (int8 quantized FastConformer)
#   - tokenizer.model             (SentencePiece tokenizer)
#
# Windows:  MODEL_HOST_PATH=C:/Users/Gufran/Documents/model
# Linux:    MODEL_HOST_PATH=/home/user/Documents/model
# macOS:    MODEL_HOST_PATH=/Users/user/Documents/model
MODEL_HOST_PATH=C:/Users/Gufran/Documents/model

# CPU threads to allocate to the container / onnxruntime.
# 2 is comfortable for Intel UHD; bump to 4 if you have headroom.
NUM_THREADS=2

# Audio window in seconds. Each WebSocket message accumulates this much
# audio before running an inference. 1.0s gives real-time feel with
# good accuracy; 0.5s is more responsive but slightly less accurate.
WINDOW_SEC=1.0
