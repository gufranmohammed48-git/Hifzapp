# Caddy config for the Hifzapp backend (local HTTPS).
#
# We listen on 8443 (HTTPS). Port 443 is often reserved/blocked on
# Windows (IIS, VMware, Windows HTTP services, etc.), so we use
# 8443 to avoid conflicts. Just put ":8443" in the URL when
# accessing from another PC.
#
# Caddy auto-generates a self-signed cert on first run. To make
# other devices trust the cert, they need to import
# hifzapp-ca.crt (see setup-https.ps1 for the export command).
#
# All traffic is proxied to the FastAPI container on port 8080.

:8443 {
    # Use the self-signed cert that Caddy generated in the data volume.
    # Caddy puts it at /data/caddy/pki/authorities/local/root.crt by default
    tls internal

    # Proxy everything to the FastAPI backend
    reverse_proxy fastconformer:8080 {
        # WebSocket support (long-lived connections)
        transport http {
            dial_timeout 30s
            response_header_timeout 86400s
            read_timeout 86400s
            write_timeout 86400s
        }
    }

    # Log to stdout
    log {
        output stdout
        level INFO
    }
}
